// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 用戶 ───────────────────────────────────────────

enum UserRole {
  PLAYER
  PARENT
  THERAPIST
}

enum TitleRarity {
  COMMON
  RARE
  EPIC
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  displayName  String
  role         UserRole     @default(PLAYER)
  totalXp      Int          @default(0)
  level        Int          @default(1)
  gamesPlayed  Int          @default(0)
  gamesWon     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  gameRecords  GameRecord[]
  aiReports    AiReport[]
  userTitles   UserTitle[]

  @@map("users")
}

// ─── 遊戲記錄 ───────────────────────────────────────

model GameRecord {
  id              String          @id @default(uuid())
  userId          String
  sessionId       String          // APP 端產生的 session ID
  startTime       DateTime
  endTime         DateTime?
  initialEmotion  String          // happy, neutral, frustrated
  result          String?         // white_wins, black_wins, draw, incomplete
  durationSeconds Int?
  createdAt       DateTime        @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  moves           MoveRecord[]
  chatHistory     ChatRecord[]
  emotionLog      EmotionRecord[]
  conversationRounds ConversationRoundRecord[]
  aiReports       AiReport[]

  @@unique([userId, sessionId])
  @@map("game_records")
}

// ─── 稱號 / 獎勵 ─────────────────────────────────────

model Title {
  id            String      @id @default(uuid())
  key           String      @unique
  nameEn        String
  nameZh        String
  descriptionEn String
  descriptionZh String
  rarity        TitleRarity @default(COMMON)
  createdAt     DateTime    @default(now())

  userTitles    UserTitle[]

  @@map("titles")
}

model UserTitle {
  id         String   @id @default(uuid())
  userId     String
  titleId    String
  unlockedAt DateTime @default(now())
  equipped   Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@map("user_titles")
}

// ─── 棋步記錄 ───────────────────────────────────────

model MoveRecord {
  id           String     @id @default(uuid())
  gameRecordId String
  moveNumber   Int
  san          String     // Standard Algebraic Notation (e.g. "e4", "Nf3")
  player       String     // "white" or "black"
  timestamp    DateTime
  preFen       String?    // FEN before move
  postFen      String?    // FEN after move

  gameRecord   GameRecord @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@map("move_records")
}

// ─── 聊天記錄 ───────────────────────────────────────

model ChatRecord {
  id           String     @id @default(uuid())
  gameRecordId String
  timestamp    DateTime
  sender       String     // "ai" or "user"
  message      String
  userChoice   String?
  aiResponse   String?
  moveNumber   Int?
  whitePreFen  String?
  whitePostFen String?
  blackPostFen String?
  roundId      String?

  gameRecord   GameRecord @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@map("chat_records")
}

// ─── 情緒記錄 ───────────────────────────────────────

model EmotionRecord {
  id           String     @id @default(uuid())
  gameRecordId String
  timestamp    DateTime
  emotion      String     // "happy", "neutral", "frustrated"
  moveNumber   Int?
  trigger      String?    // "check", "capture", "user_input", etc.

  gameRecord   GameRecord @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@map("emotion_records")
}

// ─── 對話回合（AI 問句 → 選項 → 使用者選擇 → AI 回覆） ─────

model ConversationRoundRecord {
  id           String     @id @default(uuid())
  gameRecordId String
  roundId      String
  timestamp    DateTime
  moveNumber   Int?
  emotion      String?
  trigger      String?
  intent       String?
  angleKey     String?
  promptVersion Int?
  aiQuestion   String
  choices      Json
  selectedChoice String
  aiReply      String
  createdAt    DateTime   @default(now())

  gameRecord   GameRecord @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@unique([gameRecordId, roundId])
  @@map("conversation_round_records")
}

// ─── AI 情緒報告 ─────────────────────────────────────

model AiReport {
  id           String   @id @default(uuid())
  userId       String
  gameRecordId String
  language     String
  reportJson   Json
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameRecord   GameRecord @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@unique([userId, gameRecordId, language])
  @@map("ai_reports")
}
