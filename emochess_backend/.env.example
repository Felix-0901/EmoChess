# Server
PORT=3000
NODE_ENV=development

# CORS (可選，production 建議必填)
# 多網域可用逗號分隔，例如: https://app.example.com,https://admin.example.com
CORS_ORIGIN=

# Database
POSTGRES_DB=emochess_db
POSTGRES_USER=emochess
POSTGRES_PASSWORD=your-postgres-password
# Docker Compose（api container 連到 postgres service）
DATABASE_URL=postgresql://emochess:your-postgres-password@postgres:5432/emochess_db?schema=public
# 本機直接啟動（npm run dev）時改用 localhost
# DATABASE_URL=postgresql://emochess:your-postgres-password@localhost:5432/emochess_db?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI (server-side; do NOT put keys in the mobile app)
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30
