# Copy the keys below into your shell or local secret manager.
# Do not commit real values.

# App identity
APP_IDENTIFIER=com.yourstudio.emochess
APPLE_TEAM_ID=S3DSU79C4X
APP_STORE_CONNECT_TEAM_ID=
APP_STORE_APPLE_ID=

# Release build configuration
IOS_RELEASE_API_BASE_URL=https://example.com/api

# App Store public links
APP_PRIVACY_URL=https://example.com/privacy
APP_SUPPORT_URL=https://example.com/support
APP_MARKETING_URL=

# App Store Connect API key
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=

# Use exactly one of these:
APP_STORE_CONNECT_PRIVATE_KEY=
APP_STORE_CONNECT_KEY_FILEPATH=

# Optional
APP_STORE_CONNECT_PRIVATE_KEY_IS_BASE64=false
TESTFLIGHT_CHANGELOG="Prepare EmoChess for App Store review."
SKIP_WAITING_FOR_BUILD_PROCESSING=false
UPLOAD_SCREENSHOTS=false

# Optional App Review contact info. Required only when pushing review information.
# Keep real phone/email in local env only; phone must include country code, e.g. +886...
APP_REVIEW_FIRST_NAME=
APP_REVIEW_LAST_NAME=
APP_REVIEW_EMAIL=
APP_REVIEW_PHONE=
APP_REVIEW_NOTES=
APP_REVIEW_DEMO_USER=
APP_REVIEW_DEMO_PASSWORD=
